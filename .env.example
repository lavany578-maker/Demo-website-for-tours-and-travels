# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Public browser key for @vis.gl/react-google-maps.
VITE_GOOGLE_MAPS_API_KEY=

# GOOGLE_MAPS_API_KEY: Server-side Google Maps Platform key (used for Weather API proxy).
GOOGLE_MAPS_API_KEY=

# ADMIN_PASSCODE: Optional server-side passcode overriding first-run admin setup.
ADMIN_PASSCODE=

# SMTP Configuration (Optional — required to send live emails via nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
ADMIN_NOTIFICATION_EMAIL=
